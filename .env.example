GROQ_API_KEY=your_groq_key_here
ASTRA_DB_TOKEN=AstraCS:your_token
ASTRA_DB_ENDPOINT=https://your-id-region.apps.astra.datastax.com

# Optional override. Defaults to a currently-supported Groq model.
# (The originally-spec'd llama-3.1-70b-versatile was decommissioned by Groq.)
GROQ_MODEL=llama-3.3-70b-versatile
